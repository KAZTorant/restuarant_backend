# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=True
BACKEND_PORT=8000

# Database
# Add your database configuration here

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# WhatsApp Web Integration
# URL of the WhatsApp Web service (Node.js service running locally or on same network)
