# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=https://your-app.up.railway.app

# Initial admin user (created automatically on deploy if missing)
SUPERUSER_USERNAME=admin
SUPERUSER_PASSWORD=admin123
SUPERUSER_EMAIL=admin@example.com

# Railway PostgreSQL (auto-injected when you link a Postgres service)
# DATABASE_URL=postgresql://user:password@host:5432/railway

# Local PostgreSQL fallback (used when DATABASE_URL is not set)
DB_NAME=restaurant_db
DB_USER=aykhan
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=5432

# Services
PRINTER_URL=http://localhost:3000/print
PRINTER_SERVICE=

# Print Gateway (WebSocket — cloud → restoran PC)
PRINT_GATEWAY_ENABLED=false
PRINT_GATEWAY_MODE=websocket
PRINT_GATEWAY_DEFAULT_LOCATION_ID=1
PRINT_GATEWAY_TIMEOUT=15
# HTTP mode only (PRINT_GATEWAY_MODE=http):
PRINT_GATEWAY_URL=http://127.0.0.1:3000
PRINT_GATEWAY_API_KEY=
# Redis (tövsiyə olunur production-da, çox worker üçün):
# REDIS_URL=redis://localhost:6379/0

WHATSAPP_SERVICE_URL=http://localhost:3000
RESTAURANT_OWNER_PHONE=994518000080
BACKEND_PORT=8000

# Gunicorn (optional)
WEB_CONCURRENCY=2
GUNICORN_TIMEOUT=120
