# Restaurant owner's phone number to receive notifications
# Format: 501234567 (will auto-add country code 994)
# Or full: 994501234567
RESTAURANT_OWNER_PHONE=501234567

# Printer Configuration
PRINTER_URL=http://localhost:3000/print
PRINTER_SERVICE=
